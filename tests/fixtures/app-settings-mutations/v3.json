{
  "version": 3,
  "vocabulary": {
    "areas": [
      "appTheme",
      "appThemePreset",
      "appearance",
      "confirmDestructiveFileActions",
      "density",
      "filesAndMetadataField",
      "import",
      "keyboard",
      "libraryField",
      "navigation",
      "readerField",
      "readerTheme",
      "rememberWindowState",
      "restoreLastReader",
      "showContinueReading",
      "startupBehavior",
      "window"
    ],
    "filesAndMetadataFields": ["keepEpubWritebackBackup", "liveWatcherEnabled", "scanOnStartup"],
    "libraryFields": [
      "booksCardSize",
      "booksSortBy",
      "booksViewMode",
      "foldersCardSize",
      "foldersSortBy",
      "foldersViewMode",
      "seriesCardSize",
      "seriesSortBy",
      "seriesViewMode",
      "filterSeries",
      "filterSubjects",
      "filterLanguages",
      "filterPublishers",
      "filterReadingStatuses",
      "filterFavoritesOnly",
      "filterMissingMetadata",
      "filterMissingCover",
      "smartViewsEnabled",
      "smartViewsVisible"
    ],
    "readerFields": [
      "fontSize",
      "fontFamily",
      "lineHeight",
      "readingWidth",
      "theme",
      "progressPlacement",
      "mode"
    ]
  },
  "cases": [
    {
      "name": "application font selections round trip through the appearance mutation owner",
      "steps": [
        {
          "mutation": {
            "area": "appearance",
            "value": {
              "animationsEnabled": false,
              "interfaceFont": {
                "kind": "system",
                "family": "Missing Font"
              },
              "displayFont": {
                "kind": "interface"
              }
            }
          },
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "appearance": {
                "interfaceFont": {
                  "kind": "system",
                  "family": "Missing Font"
                },
                "displayFont": {
                  "kind": "interface"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "appearance",
            "value": {
              "animationsEnabled": false,
              "interfaceFont": {
                "kind": "system",
                "family": "Missing Font"
              },
              "displayFont": {
                "kind": "system",
                "family": "Palatino Linotype"
              }
            }
          },
          "expected": {
            "revision": 2,
            "preferencesPatch": {
              "appearance": {
                "interfaceFont": {
                  "kind": "system",
                  "family": "Missing Font"
                },
                "displayFont": {
                  "kind": "system",
                  "family": "Palatino Linotype"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "appearance",
            "value": {
              "animationsEnabled": false,
              "interfaceFont": {
                "kind": "default"
              },
              "displayFont": {
                "kind": "default"
              }
            }
          },
          "expected": {
            "revision": 3,
            "preferencesPatch": {}
          }
        },
        {
          "mutation": {
            "area": "appearance",
            "value": {
              "animationsEnabled": true,
              "interfaceFont": {
                "kind": "system",
                "family": "bad\nfont"
              },
              "displayFont": {
                "kind": "system",
                "family": "  Arial  "
              }
            }
          },
          "emittedByFrontend": false,
          "expected": {
            "revision": 4,
            "preferencesPatch": {
              "appearance": {
                "animationsEnabled": true,
                "displayFont": {
                  "kind": "system",
                  "family": "Arial"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "top-level density and same-leaf revert advance revisions",
      "steps": [
        {
          "mutation": {
            "area": "density",
            "value": "compact"
          },
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "density": "compact"
            }
          }
        },
        {
          "mutation": {
            "area": "density",
            "value": "comfortable"
          },
          "expected": {
            "revision": 2,
            "preferencesPatch": {}
          }
        }
      ]
    },
    {
      "name": "independent Reader leaves merge",
      "steps": [
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontSize",
              "value": 22
            }
          },
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "reader": {
                "fontSize": 22.0
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "mode",
              "value": "continuous"
            }
          },
          "expected": {
            "revision": 2,
            "preferencesPatch": {
              "reader": {
                "fontSize": 22.0,
                "mode": "continuous"
              }
            }
          }
        }
      ]
    },
    {
      "name": "Library collection and filter leaves merge",
      "steps": [
        {
          "mutation": {
            "area": "libraryField",
            "value": {
              "field": "booksViewMode",
              "value": "list"
            }
          },
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "library": {
                "collections": {
                  "books": {
                    "viewMode": "list"
                  }
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "libraryField",
            "value": {
              "field": "filterFavoritesOnly",
              "value": true
            }
          },
          "expected": {
            "revision": 2,
            "preferencesPatch": {
              "library": {
                "collections": {
                  "books": {
                    "viewMode": "list"
                  }
                },
                "filters": {
                  "favoritesOnly": true
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Files and Metadata leaves merge",
      "steps": [
        {
          "mutation": {
            "area": "filesAndMetadataField",
            "value": {
              "field": "keepEpubWritebackBackup",
              "value": true
            }
          },
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "filesAndMetadata": {
                "keepEpubWritebackBackup": true
              }
            }
          }
        },
        {
          "mutation": {
            "area": "filesAndMetadataField",
            "value": {
              "field": "scanOnStartup",
              "value": false
            }
          },
          "expected": {
            "revision": 2,
            "preferencesPatch": {
              "filesAndMetadata": {
                "keepEpubWritebackBackup": true,
                "scanOnStartup": false
              }
            }
          }
        }
      ]
    },
    {
      "name": "global theme selections remain independent",
      "steps": [
        {
          "mutation": {
            "area": "appTheme",
            "value": {
              "kind": "custom",
              "id": "moon-ink"
            }
          },
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "appTheme": {
                "kind": "custom",
                "id": "moon-ink"
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerTheme",
            "value": {
              "kind": "builtin",
              "id": "sepia"
            }
          },
          "expected": {
            "revision": 2,
            "preferencesPatch": {
              "appTheme": {
                "kind": "custom",
                "id": "moon-ink"
              },
              "readerTheme": {
                "kind": "builtin",
                "id": "sepia"
              }
            }
          }
        }
      ]
    },
    {
      "name": "app appearance and import settings remain independent",
      "steps": [
        {
          "mutation": {
            "area": "appearance",
            "value": {
              "animationsEnabled": true,
              "interfaceFont": {
                "kind": "default"
              },
              "displayFont": {
                "kind": "default"
              }
            }
          },
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "appearance": {
                "animationsEnabled": true
              }
            }
          }
        },
        {
          "mutation": {
            "area": "import",
            "value": {
              "defaultConflictAction": "replace",
              "defaultMode": "move"
            }
          },
          "expected": {
            "revision": 2,
            "preferencesPatch": {
              "appearance": {
                "animationsEnabled": true
              },
              "import": {
                "defaultConflictAction": "replace",
                "defaultMode": "move"
              }
            }
          }
        }
      ]
    },
    {
      "name": "out-of-range Reader input normalizes but still advances revision",
      "steps": [
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontSize",
              "value": 500
            }
          },
          "emittedByFrontend": false,
          "expected": {
            "revision": 1,
            "preferencesPatch": {}
          }
        }
      ]
    },
    {
      "name": "Reader structured font leaves round trip without changing app roles",
      "steps": [
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": {
                "kind": "system",
                "family": "Missing 日本語, Book \"One\" \\ Serif"
              }
            }
          },
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "system",
                  "family": "Missing 日本語, Book \"One\" \\ Serif"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": {
                "kind": "builtin",
                "id": "literata"
              }
            }
          },
          "expected": {
            "revision": 2,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "literata"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": {
                "kind": "builtin",
                "id": "system"
              }
            }
          },
          "expected": {
            "revision": 3,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "system"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": {
                "kind": "builtin",
                "id": "serif"
              }
            }
          },
          "expected": {
            "revision": 4,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "serif"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "legacy Reader font mutations migrate but are never emitted by the frontend",
      "steps": [
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": "serif"
            }
          },
          "frontendTypechecks": false,
          "emittedByFrontend": false,
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "serif"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": "sans"
            }
          },
          "frontendTypechecks": false,
          "emittedByFrontend": false,
          "expected": {
            "revision": 2,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "sans"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": "system"
            }
          },
          "frontendTypechecks": false,
          "emittedByFrontend": false,
          "expected": {
            "revision": 3,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "system"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": "literata"
            }
          },
          "frontendTypechecks": false,
          "emittedByFrontend": false,
          "expected": {
            "revision": 4,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "literata"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": "atkinson"
            }
          },
          "frontendTypechecks": false,
          "emittedByFrontend": false,
          "expected": {
            "revision": 5,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "atkinson"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": "unknown"
            }
          },
          "frontendTypechecks": false,
          "emittedByFrontend": false,
          "expected": {
            "revision": 6,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "serif"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Reader family normalization remains within the font leaf",
      "steps": [
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": {
                "kind": "system",
                "family": "  Arial  "
              }
            }
          },
          "emittedByFrontend": false,
          "expected": {
            "revision": 1,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "system",
                  "family": "Arial"
                }
              }
            }
          }
        },
        {
          "mutation": {
            "area": "readerField",
            "value": {
              "field": "fontFamily",
              "value": {
                "kind": "system",
                "family": "bad\nfont"
              }
            }
          },
          "emittedByFrontend": false,
          "expected": {
            "revision": 2,
            "preferencesPatch": {
              "reader": {
                "fontFamily": {
                  "kind": "builtin",
                  "id": "serif"
                }
              }
            }
          }
        }
      ]
    }
  ],
  "invalid": [
    {
      "name": "unknown area",
      "mutation": {
        "area": "unknownArea",
        "value": true
      }
    },
    {
      "name": "unknown Reader field",
      "mutation": {
        "area": "readerField",
        "value": {
          "field": "unknownField",
          "value": true
        }
      }
    },
    {
      "name": "unknown Library field",
      "mutation": {
        "area": "libraryField",
        "value": {
          "field": "unknownField",
          "value": true
        }
      }
    },
    {
      "name": "boolean field cannot be a string",
      "mutation": {
        "area": "filesAndMetadataField",
        "value": {
          "field": "scanOnStartup",
          "value": "no"
        }
      }
    },
    {
      "name": "Reader mode cannot be a number",
      "mutation": {
        "area": "readerField",
        "value": {
          "field": "mode",
          "value": 3
        }
      }
    },
    {
      "name": "Reader mutation requires a value",
      "mutation": {
        "area": "readerField",
        "value": {
          "field": "fontSize"
        }
      }
    },
    {
      "name": "malformed Reader font selection {\"kind\":\"builtin\",\"id\":\"unknown\"}",
      "mutation": {
        "area": "readerField",
        "value": {
          "field": "fontFamily",
          "value": {
            "kind": "builtin",
            "id": "unknown"
          }
        }
      }
    },
    {
      "name": "malformed Reader font selection {\"kind\":\"system\"}",
      "mutation": {
        "area": "readerField",
        "value": {
          "field": "fontFamily",
          "value": {
            "kind": "system"
          }
        }
      }
    },
    {
      "name": "malformed Reader font selection {\"kind\":\"system\",\"family\":42}",
      "mutation": {
        "area": "readerField",
        "value": {
          "field": "fontFamily",
          "value": {
            "kind": "system",
            "family": 42
          }
        }
      }
    },
    {
      "name": "malformed Reader font selection {\"kind\":\"future\",\"family\":\"Arial\"}",
      "mutation": {
        "area": "readerField",
        "value": {
          "field": "fontFamily",
          "value": {
            "kind": "future",
            "family": "Arial"
          }
        }
      }
    }
  ]
}
