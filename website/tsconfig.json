{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@docusaurus/module-type-aliases"],
    "paths": {
      "@site/*": ["./*"],
      "@/*": ["./src/*"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["docusaurus.config.ts", "sidebars.ts", "src/**/*"],
  "exclude": ["node_modules", "build", ".docusaurus"]
}
