{
  "name": "archeion",
  "private": true,
  "version": "0.5.0",
  "description": "A local-first desktop EPUB reader and archive manager.",
  "author": "Khoa Luong",
  "license": "GPL-3.0-only",
  "homepage": "https://tommymoonn.github.io/archeion/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TommyMoonn/archeion.git"
  },
  "bugs": {
    "url": "https://github.com/TommyMoonn/archeion/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:summary": "vitest run --reporter=dot",
    "test:verbose": "vitest run --reporter=verbose",
    "test:inter-assets": "node scripts/verify-inter-build-assets.mjs",
    "test:watch": "vitest",
    "test:rust": "npm run rust:test",
    "test:rust:summary": "npm run rust:test:summary",
    "test:rust:verbose": "npm run rust:test:verbose",
    "test:all": "npm run test && npm run rust:test",
    "check": "npm run fmt && npm run lint && npm run typecheck && npm run test",
    "check:summary": "npm run --silent fmt && npm run --silent lint && npm run --silent typecheck && npm run --silent test:summary",
    "check:rust": "npm run rust:fmt && npm run rust:clippy && npm run rust:test",
    "check:rust:summary": "npm run --silent rust:fmt && npm run --silent rust:clippy && npm run --silent rust:test:summary",
    "check:all": "npm run check && npm run check:rust",
    "check:all:summary": "npm run --silent check:summary && npm run --silent check:rust:summary",
    "verify": "npm run check:all && npm run build && npm run test:inter-assets",
    "verify:summary": "npm run --silent check:all:summary && npm run --silent build && npm run --silent test:inter-assets",
    "version:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-release.ps1",
    "version:set": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/set-version.ps1",
    "release:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-release.ps1 -RequireChangelogEntry",
    "release:stage": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/stage-windows-bundles.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --bundles nsis,msi",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "tauri:build:msi": "tauri build --bundles msi",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:fmt:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "rust:test:summary": "cargo test --quiet --locked --manifest-path src-tauri/Cargo.toml --no-fail-fast -- --format=terse",
    "rust:test:verbose": "cargo test --locked --manifest-path src-tauri/Cargo.toml --no-fail-fast -- --nocapture",
    "clean": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/clean-generated.ps1",
    "clean:rust": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/clean-generated.ps1 -Rust",
    "clean:all": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/clean-generated.ps1 -All",
    "changes:peek": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/apply-chatgpt-zip.ps1 -DryRun",
    "changes:apply": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/apply-chatgpt-zip.ps1",
    "changes:apply:force": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/apply-chatgpt-zip.ps1 -AllowDirty",
    "changes:package": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/package-changed-files.ps1",
    "changes:restore": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/restore-chatgpt-import.ps1",
    "changes:review": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/review-changes.ps1",
    "zip": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/zip-project.ps1"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "epubjs": "^0.3.93",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "happy-dom": "^20.10.6",
    "inter-ui": "4.1.1",
    "prettier": "^3.9.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.10"
  }
}
