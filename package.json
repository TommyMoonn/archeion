{
  "name": "archeion",
  "private": true,
  "version": "1.7.0",
  "description": "A local-first desktop EPUB reader and archive manager.",
  "author": "Khoa Luong",
  "license": "GPL-3.0-only",
  "homepage": "https://tommymoonn.github.io/archeion/",
  "repository": {
    "type": "git",
    "url": "https://github.com/TommyMoonn/archeion.git"
  },
  "bugs": {
    "url": "https://github.com/TommyMoonn/archeion/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "fmt": "prettier --check .",
    "fmt:fix": "prettier --write .",
    "preview": "vite preview",
    "architecture:check": "node scripts/check-architecture.mjs",
    "ipc:check": "node --test scripts/check-tauri-command-parity.cases.mjs && node scripts/check-tauri-command-parity.mjs",
    "settings:contract:check": "node scripts/check-settings-mutation-contract.mjs",
    "docs:sync": "pnpm run docs:changelog:sync && pnpm run docs:changelog:page:sync && node scripts/sync-documentation-navigation.mjs --write && pnpm run docs:search:sync",
    "docs:check": "pnpm run docs:changelog:check && pnpm run docs:changelog:page:check && node scripts/sync-documentation-navigation.mjs --check && pnpm run docs:search:check",
    "docs:search:sync": "node scripts/sync-documentation-search.mjs --write",
    "docs:search:check": "node scripts/sync-documentation-search.mjs --check",
    "docs:changelog:sync": "node scripts/sync-documentation-changelog.mjs --write",
    "docs:changelog:check": "node scripts/sync-documentation-changelog.mjs --check",
    "docs:changelog:page:sync": "node scripts/sync-documentation-changelog-page.mjs --write",
    "docs:changelog:page:check": "node scripts/sync-documentation-changelog-page.mjs --check",
    "test:architecture": "vitest run tests/architectureBoundaries.test.ts",
    "test": "vitest run",
    "test:coverage:frontend": "vitest run --coverage --maxWorkers=4",
    "test:coverage:rust": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/coverage-rust.ps1",
    "test:browser": "pnpm run test:browser:typecheck && playwright test",
    "test:browser:typecheck": "tsc -p tsconfig.browser.json",
    "test:browser:install": "playwright install chromium --only-shell",
    "test:runtime:windows": "node scripts/run-windows-runtime-smoke.mjs",
    "test:updater:windows": "node scripts/run-windows-updater-smoke.mjs",
    "test:summary": "vitest run --reporter=dot",
    "test:verbose": "vitest run --reporter=verbose",
    "test:inter-assets": "node scripts/verify-inter-build-assets.mjs",
    "test:watch": "vitest",
    "test:rust": "pnpm run rust:test",
    "test:rust:summary": "pnpm run rust:test:summary",
    "test:rust:verbose": "pnpm run rust:test:verbose",
    "test:all": "pnpm run test && pnpm run rust:test",
    "check:frontend": "pnpm run architecture:check && pnpm run ipc:check && pnpm run settings:contract:check && pnpm run docs:check && pnpm run fmt && pnpm run lint && pnpm run typecheck && pnpm run test",
    "check": "pnpm run check:frontend",
    "check:frontend:summary": "pnpm --silent run architecture:check && pnpm --silent run ipc:check && pnpm --silent run settings:contract:check && pnpm --silent run docs:check && pnpm --silent run fmt && pnpm --silent run lint && pnpm --silent run typecheck && pnpm --silent run test:summary",
    "check:summary": "pnpm --silent run check:frontend:summary",
    "check:rust": "pnpm run rust:fmt && pnpm run rust:clippy && pnpm run rust:test",
    "check:rust:summary": "pnpm --silent run rust:fmt && pnpm --silent run rust:clippy && pnpm --silent run rust:test:summary",
    "check:all": "pnpm run check && pnpm run check:rust",
    "check:all:summary": "pnpm --silent run check:summary && pnpm --silent run check:rust:summary",
    "verify": "pnpm run check:all && pnpm run build && pnpm run test:inter-assets",
    "verify:summary": "pnpm --silent run check:all:summary && pnpm --silent run build && pnpm --silent run test:inter-assets",
    "version:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-release.ps1",
    "version:set": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/set-version.ps1",
    "release:check": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/check-release.ps1 --require-changelog",
    "release:stage": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/stage-windows-release.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "tauri build --bundles nsis,msi",
    "tauri:build:nsis": "tauri build --bundles nsis",
    "tauri:build:msi": "tauri build --bundles msi",
    "rust:fmt": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "rust:fmt:fix": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "rust:clippy": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "rust:test": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "rust:test:summary": "cargo test --quiet --locked --manifest-path src-tauri/Cargo.toml --no-fail-fast -- --format=terse",
    "rust:test:verbose": "cargo test --locked --manifest-path src-tauri/Cargo.toml --no-fail-fast -- --nocapture",
    "clean": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/clean-generated.ps1",
    "clean:rust": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/clean-generated.ps1 --rust",
    "clean:all": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/clean-generated.ps1 --all",
    "changes:peek": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/apply-changes.ps1 --dry-run",
    "changes:apply": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/apply-changes.ps1",
    "changes:apply:force": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/apply-changes.ps1 --allow-dirty",
    "changes:package": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/package-changes.ps1",
    "changes:restore": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/restore-changes.ps1",
    "changes:review": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/review-changes.ps1",
    "zip:repo": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/zip-project.ps1 --mode repo",
    "zip:workspace": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/zip-project.ps1 --mode workspace",
    "test:browser:ui-stability": "vite build --config tests/browser/visual-refinement-build.config.ts && playwright test --config tests/browser/ui-stability.config.ts",
    "test:browser:visual-diagnostics": "vite build --config tests/browser/visual-refinement-build.config.ts && playwright test --config tests/browser/visual-refinement-diagnostics.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "epubjs": "^0.3.93",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "@xmldom/xmldom": "0.9.12",
    "ajv": "^8.20.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "happy-dom": "^21.0.4",
    "inter-ui": "4.1.1",
    "jszip": "3.10.2",
    "prettier": "^3.9.10",
    "selenium-webdriver": "4.52.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.9.12"
    },
    "onlyBuiltDependencies": [
      "core-js",
      "es5-ext"
    ]
  }
}
