  "reader": {
    "base": "light",
    "background": "#FCFCFC",
    "surface": "#EEEEEE",
    "line": "#D8D8D8",
    "text": "#333333",
    "strong": "#191919",
    "muted": "#5B5B5B",
    "focus": "#4C4C4C",
    "danger": "#963E49",
    "link": "#333333",
    "codeBackground": "#EEEEEE",
    "selection": "#E3E3E3"
  }
