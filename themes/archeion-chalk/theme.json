{
  "$schema": "https://tommymoonn.github.io/archeion/schemas/archeion-theme-v1.schema.json",
  "schemaVersion": 1,
  "id": "archeion-chalk",
  "name": "Archeion Chalk",
  "author": "Khoa Luong",
  "description": "A clean, near-white monochrome theme with grayscale accents.",
  "base": "light",
  "app": {
    "canvas": "#F7F7F7",
    "canvasDeep": "#E5E5E5",
    "surface": "#FFFFFF",
    "surfaceRaised": "#FBFBFB",
    "surfaceHover": "#EEEEEE",
    "frame": "#F0F0F0",
    "sidebar": "#EEEEEE",
    "main": "#FAFAFA",
    "mainRaised": "#FCFCFC",
    "line": "#D8D8D8",
    "lineStrong": "#BDBDBD",
    "text": "#424242",
    "textStrong": "#1E1E1E",
    "muted": "#5B5B5B",
    "mutedSoft": "#858585",
    "accent": "#4C4C4C",
    "accentStrong": "#333333",
    "focus": "#4C4C4C",
    "success": "#477B58",
    "warning": "#8A641F",
    "error": "#A64B68",
    "info": "#2D7F78"
