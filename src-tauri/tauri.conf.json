{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Archeion",
  "version": "1.0.1",
  "identifier": "com.archeion.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Archeion",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost blob: data:",
        "font-src": "'self' blob: data:",
        "frame-src": "'self' blob: data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob: data:",
        "worker-src": "'self' blob:"
      },
      "devCsp": {
        "default-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 blob: data:",
        "font-src": "'self' blob: data:",
        "frame-src": "'self' blob: data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "media-src": "'self' blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline' blob: data:",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "publisher": "Khoa Luong",
    "copyright": "Copyright © 2026 Khoa Luong",
    "homepage": "https://tommymoonn.github.io/archeion/",
    "shortDescription": "A local-first desktop EPUB reader and archive manager.",
    "longDescription": "Archeion is a local-first Windows desktop app for organizing EPUB archives, editing book metadata, and reading with persistent progress.",
    "useLocalToolsDir": true,
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US",
        "upgradeCode": "dd33f41c-13de-58f4-a67c-28ffd4482b07"
      }
    }
  },
  "mainBinaryName": "Archeion"
}
